# Process Tracker API — Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000

# Authentication — use a strong random string
API_KEY=your-secret-api-key-here

# PostgreSQL
DATABASE_URL=postgres://user:password@localhost:5432/process_tracker

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=process-tracker-screenshots
R2_PUBLIC_URL=https://your-r2-public-domain.com
